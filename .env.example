# Application
APP_NAME=Robust RAG
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console

# PostgreSQL
DATABASE_URL=postgresql+psycopg://localhost:5432/robust_rag
DATABASE_ECHO=false

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Local storage
STORAGE_ROOT=../data
UPLOAD_MAX_BYTES=104857600
UPLOAD_CHUNK_BYTES=1048576
JOB_RECOVERY_AGE_SECONDS=300
CELERY_HEALTH_TIMEOUT_SECONDS=1
CELERY_QUEUE_WARNING_DEPTH=100
CELERY_HEARTBEAT_TTL_SECONDS=120

# MinerU cloud precision API (https://mineru.net/apiManage/token)
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_TOKEN=
MINERU_TIMEOUT_SECONDS=600
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_MODEL_VERSION=vlm
MINERU_OCR_ENABLED=true
LIBREOFFICE_PATH=soffice

# Versioned structure-aware cleaning
CLEANING_CONFIG_VERSION=stage3-cleaning-v1
CLEANING_BOILERPLATE_MIN_OCCURRENCES=3
CLEANING_BOILERPLATE_MIN_PAGE_RATIO=0.6
CLEANING_NEAR_DUPLICATE_THRESHOLD=0.92
CLEANING_NEAR_DUPLICATE_MIN_CHARS=80

# Versioned document quality policy
QUALITY_RULE_SET_VERSION=stage4-quality-rules-v1
QUALITY_POLICY_VERSION=stage4-quality-policy-v1
QUALITY_CORRUPTION_WARNING_RATIO=0.001
QUALITY_CORRUPTION_QUARANTINE_RATIO=0.05
QUALITY_CORRUPTION_REJECT_RATIO=0.30
QUALITY_DUPLICATE_QUARANTINE_RATIO=0.50
QUALITY_MISSING_LOCATOR_QUARANTINE_RATIO=0.30
QUALITY_EMPTY_PAGE_QUARANTINE_RATIO=0.50
QUALITY_PARSER_CONFIDENCE_WARNING=0.50
QUALITY_LOW_CONFIDENCE_QUARANTINE_RATIO=0.50
QUALITY_INFORMATION_DENSITY_WARNING=0.40
QUALITY_INFORMATION_DENSITY_QUARANTINE=0.20
QUALITY_REJECT_PARSE_THRESHOLD=0.05
QUALITY_REJECT_TEXT_THRESHOLD=0.20
QUALITY_QUARANTINE_DIMENSION_THRESHOLD=0.50
QUALITY_WARNING_DIMENSION_THRESHOLD=0.80
QUALITY_SPARSE_EXTRACTION_MIN_BYTES=1048576
QUALITY_SPARSE_EXTRACTION_MIN_CHARS_PER_MB=100

# Optional Dingo 2.5 evaluators. Install with: uv sync --extra dingo
DINGO_ENABLED=false
DINGO_RULE_ENABLED=true
DINGO_LLM_ENABLED=false
DINGO_RULE_NAMES=RuleAbnormalChar,RuleAbnormalHtml,RuleContentNull
DINGO_LLM_API_KEY=
DINGO_LLM_MAX_CHARS=30000

# Versioned structure-aware parent/child chunking
CHUNKING_CONFIG_VERSION=stage5-parent-child-v2
CHUNKING_PARENT_TARGET_TOKENS=1800
CHUNKING_PARENT_MAX_TOKENS=2500
CHUNKING_CHILD_TARGET_TOKENS=500
CHUNKING_CHILD_MAX_TOKENS=600
CHUNKING_CHILD_OVERLAP_TOKENS=64

# Voyage document embeddings
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-4
VOYAGE_EMBEDDING_DIMENSION=1024
VOYAGE_EMBEDDING_CONFIG_VERSION=stage6-chunk-content-v2
VOYAGE_EMBEDDING_BATCH_ITEMS=128
VOYAGE_EMBEDDING_BATCH_TOKENS=8000
# Safe defaults for an account without a payment method (3 RPM / 10K TPM).
# The TPM budget keeps 10% headroom for token-estimation differences and queries.
VOYAGE_EMBEDDING_RATE_LIMIT_ENABLED=true
VOYAGE_EMBEDDING_RATE_LIMIT_RPM=3
VOYAGE_EMBEDDING_RATE_LIMIT_TPM=9000
VOYAGE_EMBEDDING_RATE_LIMIT_WINDOW_SECONDS=60
VOYAGE_EMBEDDING_RATE_LIMIT_FALLBACK_SECONDS=65
VOYAGE_EMBEDDING_MAX_RETRIES=3
VOYAGE_EMBEDDING_RETRY_BASE_SECONDS=1
VOYAGE_EMBEDDING_RETRY_MAX_SECONDS=30
# Set from the currently contracted Voyage price; no price is hard-coded.
VOYAGE_EMBEDDING_PRICE_PER_MILLION_TOKENS=
VOYAGE_TIMEOUT_SECONDS=60
VOYAGE_RERANK_MODEL=rerank-2.5
VOYAGE_RERANK_MAX_RETRIES=2
VOYAGE_RERANK_RETRY_BASE_SECONDS=1
VOYAGE_RERANK_RETRY_MAX_SECONDS=15
# Set from the currently contracted Voyage price; no price is hard-coded.
VOYAGE_RERANK_PRICE_PER_MILLION_TOKENS=

# Aiven for OpenSearch projection
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT=
OPENSEARCH_VERIFY_TLS=true
OPENSEARCH_TIMEOUT_SECONDS=30
OPENSEARCH_INDEX_CONFIG_VERSION=stage6-opensearch-v2
OPENSEARCH_DOCUMENTS_INDEX=rag-documents-v1
OPENSEARCH_CHUNKS_INDEX=rag-chunks-v1
OPENSEARCH_DOCUMENTS_READ_ALIAS=rag-documents-read
OPENSEARCH_CHUNKS_READ_ALIAS=rag-chunks-read
OPENSEARCH_CHUNKS_WRITE_ALIAS=rag-chunks-write
OPENSEARCH_BULK_ACTIONS=250
OPENSEARCH_MAX_RETRIES=3
OPENSEARCH_RETRY_BASE_SECONDS=1
OPENSEARCH_RETRY_MAX_SECONDS=30

# Optional stage 9 Neo4j Aura graph projection. Keep disabled until credentials are set.
GRAPH_ENABLED=false
GRAPH_SCHEMA_VERSION=enterprise-core-v1
GRAPH_EXTRACTOR_VERSION=llama-schema-v3
GRAPH_PROMPT_VERSION=stage9-extraction-v3
GRAPH_LLM_REASONING_EFFORT=none
GRAPH_LLM_MAX_OUTPUT_TOKENS=8000
GRAPH_LLM_MAX_RETRIES=3
GRAPH_LLM_RETRY_BASE_SECONDS=2
GRAPH_LLM_RETRY_MAX_SECONDS=15
GRAPH_MAX_FAILED_PARENT_RATIO=0.2
GRAPH_RUN_STALE_SECONDS=900
GRAPH_BUILD_MAX_ATTEMPTS=2
GRAPH_MAX_TRIPLETS_PER_PARENT=12
GRAPH_EXTRACTION_WORKERS=2
GRAPH_QUERY_ENABLED=true
GRAPH_QUERY_MAX_DEPTH=3
GRAPH_QUERY_MAX_ROWS=50
GRAPH_QUERY_TIMEOUT_SECONDS=3
GRAPH_TEXT_TO_CYPHER_TIMEOUT_SECONDS=8
GRAPH_RRF_WEIGHT=0.8
NEO4J_URL=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Stage 7 hybrid retrieval and context assembly
RETRIEVAL_CONFIG_VERSION=stage7-hierarchical-v2
RETRIEVAL_QUERY_MAX_CHARS=2000
RETRIEVAL_BM25_TOP_K=100
RETRIEVAL_DOCUMENT_BM25_TOP_K=50
RETRIEVAL_DENSE_TOP_K=100
RETRIEVAL_RRF_TOP_K=60
RETRIEVAL_RRF_RANK_CONSTANT=60
RETRIEVAL_BM25_WEIGHT=1
RETRIEVAL_DENSE_WEIGHT=1
RETRIEVAL_DOCUMENT_WEIGHT=0.5
RETRIEVAL_MAX_CHILDREN_PER_DOCUMENT=8
RETRIEVAL_MAX_CHILDREN_PER_PARENT=3
RETRIEVAL_RERANK_CANDIDATE_TOP_K=40
RETRIEVAL_FINAL_CHILD_TOP_K=10
RETRIEVAL_RERANK_FALLBACK_ENABLED=true
RETRIEVAL_CONTEXT_MAX_TOKENS=8000
RETRIEVAL_CONTEXT_PARENT_MAX_TOKENS=2500
RETRIEVAL_CONTEXT_NEIGHBOR_LIMIT=1

# Generation (direct OpenAI Responses-compatible API)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4
LLM_API_STYLE=responses
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_SECONDS=1
LLM_MAX_OUTPUT_TOKENS=2000
# Set from the contracted upstream price; no model price is hard-coded.
LLM_PRICE_PER_MILLION_INPUT_TOKENS=
LLM_PRICE_PER_MILLION_OUTPUT_TOKENS=
GENERATION_PROMPT_VERSION=stage8-grounded-rag-v2-zh
QUERY_REWRITE_PROMPT_VERSION=stage8-retrieval-query-plan-v1-zh
QUERY_REWRITE_HISTORY_MESSAGES=6
QUERY_REWRITE_MAX_OUTPUT_TOKENS=500
CITATION_EXCERPT_MAX_CHARS=500

# Stage 13 LangGraph Agentic RAG. Keep disabled until provider Tool Call contract passes.
AGENTIC_RAG_ENABLED=true
AGENT_GRAPH_VERSION=stage13-langgraph-agentic-rag-v2
AGENT_PROMPT_VERSION=stage13-agent-decision-v3-zh
AGENT_MAX_OUTPUT_TOKENS=500
AGENT_REASONING_EFFORT=none
AGENT_RECURSION_LIMIT=12

# Stage 11 golden evaluation datasets and generated reports
EVALUATION_DATASET_ROOT=../evals/datasets
EVALUATION_REPORT_ROOT=../evals/reports

# Stage 12 Langfuse Cloud. Enabled by default; missing credentials degrade telemetry only.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
# Keep false for enterprise data unless raw prompt/response export is explicitly approved.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_TIMEOUT_SECONDS=3
LANGFUSE_FLUSH_AT=20
LANGFUSE_FLUSH_INTERVAL_SECONDS=5

# Frontend
VITE_API_BASE_URL=/api/v1
