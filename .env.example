# Application
APP_NAME=Robust RAG
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console

# PostgreSQL
DATABASE_URL=postgresql+psycopg://localhost:5432/robust_rag
DATABASE_ECHO=false

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Local storage
STORAGE_ROOT=../data
UPLOAD_MAX_BYTES=104857600
UPLOAD_CHUNK_BYTES=1048576
JOB_RECOVERY_AGE_SECONDS=300

# External services (configured in later stages)
MINERU_BASE_URL=
MINERU_API_KEY=
MINERU_TIMEOUT_SECONDS=600
MINERU_BACKEND=vlm-auto-engine
LIBREOFFICE_PATH=soffice
DINGO_ENABLED=false
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4
VOYAGE_RERANK_MODEL=rerank-2.5
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT=
LLM_BASE_URL=http://127.0.0.1:15721/v1
LLM_MODEL=gpt-5.6-luna
LLM_API_STYLE=responses
LLM_REASONING_EFFORT=medium

# Frontend
VITE_API_BASE_URL=/api/v1
